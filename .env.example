# PostgreSQL (required). On Railway, link a Postgres service — DATABASE_URL is injected automatically.
# Local example:
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/yap_to_context
DATABASE_URL=

# --- Railway (recommended): add these as Variables on the web service ---
# OPENAI_API_KEY   → from platform.openai.com (never commit real keys)
# INGEST_API_KEY   → short password users enter to sign in / call APIs (Bearer or X-Api-Key)
# AUTH_SECRET      → random string (e.g. openssl rand -hex 32); required in production when INGEST_API_KEY is set so cookies are signed separately from the password

# Optional on Railway if you configure keys in the app (Settings page).
# When set here, they override anything stored in the database.
OPENAI_API_KEY=

# App password: visitors sign in with this; APIs accept Bearer / X-Api-Key.
INGEST_API_KEY=

# Required on Railway when INGEST_API_KEY is set: cookie signing secret (different from the password).
AUTH_SECRET=

# Audio file storage (not in Postgres). Local default: ./storage/audio
# On Railway, mount a volume or set to a persistent path, e.g. /data/audio
AUDIO_STORAGE_PATH=

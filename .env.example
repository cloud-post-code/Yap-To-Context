# PostgreSQL (required). On Railway, link a Postgres service — DATABASE_URL is injected automatically.
# Local example:
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/yap_to_context
DATABASE_URL=

# Optional on Railway if you configure keys in the app (Settings page).
# When set here, they override anything stored in the database.
OPENAI_API_KEY=

# App password: visitors sign in with this; APIs accept Bearer / X-Api-Key. Cookie sign-in works without AUTH_SECRET.
INGEST_API_KEY=

# Optional extra cookie-signing secret; if unset, INGEST_API_KEY (or the stored ingest key) is used for signatures.
AUTH_SECRET=

# Audio file storage (not in Postgres). Local default: ./storage/audio
# On Railway, mount a volume or set to a persistent path, e.g. /data/audio
AUDIO_STORAGE_PATH=

# Optional on Railway if you configure keys in the app (Settings page → SQLite).
# When set here, they override anything stored in the database.
OPENAI_API_KEY=
INGEST_API_KEY=

# Recommended on Railway (and any production-like deploy) so the browser can sign in with cookies.
AUTH_SECRET=

# Local defaults: ./data/app.db and ./storage/audio
# On Railway (production-like), defaults become /data/app.db and /data/audio unless overridden:
SQLITE_PATH=
AUDIO_STORAGE_PATH=
